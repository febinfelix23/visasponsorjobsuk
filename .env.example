# Copy to .env.local and fill in. Never commit .env.local.

# Supabase → Project Settings → API. Used for Google sign-in. The publishable key is
# safe in the browser; never put the secret (service role) key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<sb_publishable_...>

# Supabase → Connect → Transaction pooler (port 6543). Used by the app and scripts.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Supabase → Connect → Session pooler (port 5432). Used by drizzle-kit migrations.
DIRECT_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Optional. Anthropic API key for the AI board check (and later the blog writer).
# Use its own key from the project workspace; never commit the real value.
ANTHROPIC_API_KEY=<your-anthropic-api-key>

# The public site address, used for links in posts, Instagram cards, the sitemap and canonical links.
NEXT_PUBLIC_SITE_URL=https://<your-domain>

# Shown on the Privacy and Terms pages for contact and data requests. Use a mailbox you read.
NEXT_PUBLIC_CONTACT_EMAIL=hello@<your-domain>

# Run reports (GitHub Actions → your Telegram). Token from @BotFather; chat ID from `npm run telegram:chat-id`.
TELEGRAM_BOT_TOKEN=<bot-token>
TELEGRAM_CHAT_ID=<chat-id>
